# Authentication (replace with a long random value)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_HOURS=168

# MySQL
DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/smart_construction?charset=utf8mb4

# FFmpeg / ISAPI
FFMPEG_PATH=ffmpeg
ISAPI_CONNECT_TIMEOUT=30
ISAPI_SEARCH_READ_TIMEOUT=60
ISAPI_DOWNLOAD_READ_TIMEOUT=3600
ISAPI_DOWNLOAD_RETRIES=3

# RTSP preview and reconnect behavior
RTSP_SAVE_ARCHIVE=false
PREVIEW_MAX_WIDTH=960
PREVIEW_JPEG_QUALITY=75
PREVIEW_MIN_INTERVAL=0.08
RTSP_READ_FAIL_BEFORE_RECONNECT=150
RTSP_RECONNECT_DELAY_SEC=3
RTSP_RECONNECT_OPEN_TIMEOUT_SEC=15

# SMS notification (disabled by default)
SMS_ENABLED=false
SMS_API_URL=http://106.ihuyi.com/webservice/sms.php?method=Submit
SMS_API_ID=
SMS_API_KEY=
SMS_PHONES=
SMS_COOLDOWN_MINUTES=30
